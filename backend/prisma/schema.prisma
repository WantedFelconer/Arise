datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// 1. Identity, Authentication & Profile
// ---------------------------------------------------------

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  difficultyMode String    @default("casual") @map("difficulty_mode") // casual | hardcore
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  character           Character?
  settings            Settings?
  circadianProfile    CircadianProfile?
  refreshTokens       RefreshToken[]
  devices             Device[]
  quests              Quest[]
  habits              Habit[]
  bosses              Boss[]
  dungeons            Dungeon[]
  gateSessions        GateSession[]
  notes               Note[]
  noteFolders         NoteFolder[]
  reminders           Reminder[]
  screenTimeSessions  ScreenTimeSession[]
  inboxItems          InboxItem[]
  analyticsSnapshots  AnalyticsSnapshot[]
  syncEvents          SyncEvent[]
  idempotencyRecords  IdempotencyRecord[]
  userAchievements    UserAchievement[]
  fitnessLogs         FitnessLog[]
  aiGeneratedPlans    AiGeneratedPlan[]
  aiConversations     AiConversation[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CircadianProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  profileType String   @default("early_bird") @map("profile_type") // early_bird | night_owl | custom
  customCurve Json?    @map("custom_curve")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("circadian_profiles")
}

model Device {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String    @map("device_id")
  deviceName   String?   @map("device_name")
  pushToken    String?   @map("push_token")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("devices")
}

model Settings {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @unique @map("user_id") @db.Uuid
  theme                   String   @default("system_dark")
  soundEnabled            Boolean  @default(true) @map("sound_enabled")
  hapticsEnabled          Boolean  @default(true) @map("haptics_enabled")
  dailyReminderTime       String?  @map("daily_reminder_time")
  notificationPreferences Json     @default("{\"questReminders\":true,\"gateAlerts\":true,\"dailyReview\":true}") @map("notification_preferences")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ---------------------------------------------------------
// 2. Character & Progression Ledger
// ---------------------------------------------------------

model Character {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  level          Int      @default(1)
  totalXp        Int      @default(0) @map("total_xp")
  currentMana    Int      @default(100) @map("current_mana")
  maxMana        Int      @default(100) @map("max_mana")
  coins          Int      @default(0)
  gems           Int      @default(0)
  rank           String   @default("E")
  activeTitleId  String?  @map("active_title_id")
  stats          Json     @default("{\"intelligence\":10,\"discipline\":10,\"fitness\":10,\"creativity\":10,\"coding\":10,\"business\":10,\"health\":10}")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpTransactions   XpTransaction[]
  manaTransactions ManaTransaction[]

  @@map("characters")
}

model XpTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  characterId  String    @map("character_id") @db.Uuid
  amount       Int
  sourceType   String    @map("source_type") // quest | gate | habit | penalty | bonus
  sourceId     String?   @map("source_id")
  statKey      String?   @map("stat_key")   // intelligence | discipline | fitness | creativity | coding | business | health
  reason       String?
  createdAt    DateTime  @default(now()) @map("created_at")

  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@map("xp_transactions")
}

model ManaTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  characterId  String    @map("character_id") @db.Uuid
  delta        Int       // positive (restore) or negative (deplete)
  sourceType   String    @map("source_type") // quest | gate_collapse | screen_time | sleep | exercise
  sourceId     String?   @map("source_id")
  reason       String?
  createdAt    DateTime  @default(now()) @map("created_at")

  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@map("mana_transactions")
}

// ---------------------------------------------------------
// 3. Quests & Dependencies
// ---------------------------------------------------------

model Quest {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  bossId           String?       @map("boss_id") @db.Uuid
  parentQuestId    String?       @map("parent_quest_id") @db.Uuid
  title            String
  description      String?
  questType        String        @default("daily") @map("quest_type") // daily | main | side | recurring | boss | ai_generated
  priority         String        @default("medium")
  difficulty       String        @default("medium") // trivial | easy | medium | hard | epic
  status           String        @default("active") // active | in_progress | completed | archived | trashed
  estimatedMinutes Int           @default(30) @map("estimated_minutes")
  actualMinutes    Int?          @map("actual_minutes")
  deadline         DateTime?
  recurrenceRule   Json?         @map("recurrence_rule")
  tags             String[]      @default([])
  isFavorite       Boolean       @default(false) @map("is_favorite")
  isPinned         Boolean       @default(false) @map("is_pinned")
  eisenhowerQuadrant String?     @map("eisenhower_quadrant")
  completedAt      DateTime?     @map("completed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  boss             Boss?         @relation(fields: [bossId], references: [id], onDelete: SetNull)
  parentQuest      Quest?        @relation("SubQuests", fields: [parentQuestId], references: [id], onDelete: Cascade)
  subQuests        Quest[]       @relation("SubQuests")
  gateSessions     GateSession[]
  dependencies     QuestDependency[] @relation("QuestPrerequisites")
  dependents       QuestDependency[] @relation("QuestDependents")

  @@index([userId, status])
  @@map("quests")
}

model QuestDependency {
  id                String   @id @default(uuid()) @db.Uuid
  questId           String   @map("quest_id") @db.Uuid
  dependsOnQuestId  String   @map("depends_on_quest_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  quest             Quest    @relation("QuestPrerequisites", fields: [questId], references: [id], onDelete: Cascade)
  dependsOnQuest    Quest    @relation("QuestDependents", fields: [dependsOnQuestId], references: [id], onDelete: Cascade)

  @@unique([questId, dependsOnQuestId])
  @@map("quest_dependencies")
}

// ---------------------------------------------------------
// 4. Habits & Logs (Phase 2 Roadmap Schema Preservation)
// ---------------------------------------------------------

model Habit {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  title          String
  frequency      Json
  skipAllowance  Int        @default(1) @map("skip_allowance")
  currentStreak  Int        @default(0) @map("current_streak")
  longestStreak  Int        @default(0) @map("longest_streak")
  reminderTimes  String[]   @default([]) @map("reminder_times")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs           HabitLog[]

  @@map("habits")
}

model HabitLog {
  id          String   @id @default(uuid()) @db.Uuid
  habitId     String   @map("habit_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")
  skipped     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("habit_logs")
}

// ---------------------------------------------------------
// 5. Bosses & Dungeons
// ---------------------------------------------------------

model Boss {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  dungeonId   String?   @map("dungeon_id") @db.Uuid
  title       String
  description String?
  hpMax       Int       @map("hp_max")
  hpCurrent   Int       @map("hp_current")
  difficulty  String    @default("medium")
  status      String    @default("active") // active | defeated
  deadline    DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dungeon     Dungeon?  @relation(fields: [dungeonId], references: [id], onDelete: SetNull)
  quests      Quest[]

  @@index([userId, status])
  @@map("bosses")
}

model Dungeon {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  status      String   @default("active") // active | completed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bosses      Boss[]

  @@map("dungeons")
}

// ---------------------------------------------------------
// 6. Gate Focus Sessions
// ---------------------------------------------------------

model GateSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  questId          String?   @map("quest_id") @db.Uuid
  plannedDurationS Int       @map("planned_duration_s")
  actualDurationS  Int?      @map("actual_duration_s")
  pauseCount       Int       @default(0) @map("pause_count")
  status           String    @default("in_progress") // in_progress | completed | collapsed
  stabilityFinal   Float?    @map("stability_final")
  xpAwarded        Int?      @map("xp_awarded")
  manaDelta        Int?      @map("mana_delta")
  exitReason       String?   @map("exit_reason")
  deviceId         String?   @map("device_id")
  clientEventId    String?   @unique @map("client_event_id")
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest            Quest?    @relation(fields: [questId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("gate_sessions")
}

// ---------------------------------------------------------
// 7. Screen Time, Notes, Inbox & Reminders
// ---------------------------------------------------------

model ScreenTimeSession {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  appPackage           String   @map("app_package")
  category             String
  durationS            Int      @map("duration_s")
  occurredAt           DateTime @map("occurred_at")
  manaModifierApplied  Int      @default(0) @map("mana_modifier_applied")
  createdAt            DateTime @default(now()) @map("created_at")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("screen_time_sessions")
}

model InboxItem {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  rawContent              String   @map("raw_content")
  captureType             String   @default("text") @map("capture_type") // text | voice | photo | screenshot
  status                  String   @default("unsorted") // unsorted | triaged | converted
  aiSuggestedDestination  Json?    @map("ai_suggested_destination")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inbox_items")
}

model NoteFolder {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@map("note_folders")
}

model Note {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  folderId     String?     @map("folder_id") @db.Uuid
  title        String
  body         String      @default("")
  tags         String[]    @default([])
  notionPageId String?     @map("notion_page_id")
  syncStatus   String      @default("synced") @map("sync_status")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@map("notes")
}

model Reminder {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String   @default("quest") // quest | habit | deadline | wellness | behavioral
  message       String
  triggerConfig Json     @map("trigger_config")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// ---------------------------------------------------------
// 8. Analytics & Fitness
// ---------------------------------------------------------

model AnalyticsSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  period      String   // daily | weekly | monthly | yearly
  periodStart DateTime @map("period_start")
  metrics     Json
  aiSummary   String?  @map("ai_summary")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodStart])
  @@map("analytics_snapshots")
}

model FitnessLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  logType    String   @map("log_type") // steps | sleep | exercise | water | weight
  value      Float
  unit       String
  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("fitness_logs")
}

// ---------------------------------------------------------
// 9. Achievements
// ---------------------------------------------------------

model Achievement {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique
  title         String
  description   String
  category      String
  xpReward      Int               @default(0) @map("xp_reward")
  badgeAssetUrl String?           @map("badge_asset_url")
  createdAt     DateTime          @default(now()) @map("created_at")

  userUnlocks   UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  achievementId String      @map("achievement_id") @db.Uuid
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ---------------------------------------------------------
// 10. Sync Events & Generalized Idempotency Records
// ---------------------------------------------------------

model SyncEvent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  deviceId          String   @map("device_id")
  eventType         String   @map("event_type")
  payload           Json
  occurredAtClient  DateTime @map("occurred_at_client")
  receivedAtServer  DateTime @default(now()) @map("received_at_server")
  syncStatus        String   @default("pending") @map("sync_status") // pending | syncing | synced | failed | conflict | cancelled
  retryCount        Int      @default(0) @map("retry_count")
  version           Int      @default(1)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, syncStatus])
  @@map("sync_events")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  operationType  String   @map("operation_type")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, idempotencyKey])
  @@map("idempotency_records")
}

// ---------------------------------------------------------
// 11. AI Intelligence Layer (Sprint 3)
// ---------------------------------------------------------

model AiGeneratedPlan {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  goal             String
  context          Json
  rawPlan          Json      @map("raw_plan")
  status           String    @default("pending_approval") // pending_approval | edited | approved | rejected
  approvedQuestIds String[]  @default([]) @map("approved_quest_ids")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ai_generated_plans")
}

model AiConversation {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  title       String      @default("Coach Conversation")
  contextType String      @default("coach") @map("context_type") // coach | daily | weekly_review | general
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           String         // user | assistant | system | tool
  content        String
  toolCalls      Json?          @map("tool_calls")
  toolCallId     String?        @map("tool_call_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid // null = global
  flagKey   String   @map("flag_key")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, flagKey])
  @@map("feature_flags")
}

